# Toss Open API credentials (OAuth2 client-credentials).
#
# Copy this file to `.env` and fill in your OWN values. `.env` is git-ignored
# (see .gitignore "Secrets and Credentials") and MUST NEVER be committed.
# The application reads these via ballast.adapters.toss.from_env() — secrets
# live only in the environment, never in source.
#
# Load them into your shell before running, e.g.:
#   set -a && . ./.env && set +a
#
# If these credentials are ever pasted into a chat, log, or any shared channel,
# treat them as compromised and rotate them in the Toss developer console.
#
# ---------------------------------------------------------------------------
# CREDENTIAL MAPPING (read this — the Toss console labels are the OAuth roles
# REVERSED, which causes a `401 invalid_client: ...client_id` if mixed up):
#
#   Toss console "Secret Key"  (starts `tsck_…`, c = client)  -> TOSS_CLIENT_ID
#   Toss console "API Key"     (starts `tssk_…`, s = secret)  -> TOSS_CLIENT_SECRET
#
# i.e. the value Toss calls the "Secret Key" is the OAuth2 client_id, and the
# value Toss calls the "API Key" is the OAuth2 client_secret. The token endpoint
# uses the standard client_credentials grant (client id/secret in the form body).
# ---------------------------------------------------------------------------

# OAuth2 client_id  — the Toss console "Secret Key" (tsck_…).
TOSS_CLIENT_ID=tsck_live_your-client-id-here
# OAuth2 client_secret — the Toss console "API Key" (tssk_…).
TOSS_CLIENT_SECRET=tssk_live_your-client-secret-here

# Optional — defaults to the public Toss Open API host when unset.
# TOSS_BASE_URL=https://openapi.tossinvest.com
